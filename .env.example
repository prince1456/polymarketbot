# Polymarket Copy Trading Bot Configuration

# ===== WALLET CONFIGURATION =====
# Your wallet private key (KEEP THIS SECRET!)
# Example: 0xabcdef1234567890...
PRIVATE_KEY=your_private_key_here

# Target trader's wallet address to copy
# Example: 0x1234567890abcdef...
TARGET_WALLET=target_wallet_address_here

# ===== TRADING CONFIGURATION =====
# Target trader's total balance in USD (optional, 0 = auto-fetch)
# When set to 0, the bot automatically fetches the target's portfolio value
# (on-chain USDC + Polymarket position values) for accurate ratio matching.
# Set manually only if you want to override the auto-detected value.
# TARGET_BALANCE=200000
TARGET_BALANCE=0

# Maximum USD amount per single trade (safety limit)
MAX_TRADE_SIZE=100

# Maximum total USD spending per day (resets at midnight UTC)
DAILY_SPENDING_LIMIT=500

# Minimum liquidity ratio before placing trade (0-1)
MIN_LIQUIDITY_RATIO=0.1

# Slippage tolerance percentage (0.01 = 1%)
SLIPPAGE_TOLERANCE=0.02

# ===== NETWORK =====
# Polygon RPC URL (default: public endpoint, recommend using Alchemy/Infura for reliability)
# Free Alchemy: https://www.alchemy.com/ → create app → select Polygon → copy URL
# RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://polygon-rpc.com

# Polymarket API endpoint (default: production)
# POLYMARKET_API_URL=https://clob.polymarket.com

# ===== OPERATIONAL SETTINGS =====
# Enable dry run mode (true/false) - simulates trades without executing
DRY_RUN=true

# Polling interval in seconds
POLL_INTERVAL=60

# Database file path
DATABASE_PATH=./polymarket.db
