# Polymarket Copy Trading Bot Configuration

# ===== WALLET CONFIGURATION =====
# Your wallet private key (KEEP THIS SECRET!)
# Example: 0xabcdef1234567890...
PRIVATE_KEY=your_private_key_here

# Target trader's wallet address to copy
# Example: 0x1234567890abcdef...
TARGET_WALLET=target_wallet_address_here

# ===== POLYMARKET API =====
# API key for Polymarket CLOB client
# Get from: https://docs.polymarket.com/
POLYMARKET_API_KEY=your_api_key_here

# API endpoint (default: production)
# POLYMARKET_API_URL=https://clob.polymarket.com

# ===== TRADING CONFIGURATION =====
# The target trader's estimated total balance in USD
# Used for ratio-based copy trading: if target has 200k and trades $2000,
# and you have $200, the bot will trade $2 (same 1% ratio)
TARGET_BALANCE=200000

# Maximum USD amount per single trade (safety limit)
# Example: 100 means no single trade can exceed $100
MAX_TRADE_SIZE=100

# Maximum total USD spending per day (resets at midnight UTC)
# Example: 500 means bot stops after spending $500 in a day
DAILY_SPENDING_LIMIT=500

# Minimum liquidity ratio before placing trade (0-1)
# Example: 0.1 means market must have at least 10% of your trade size in liquidity
MIN_LIQUIDITY_RATIO=0.1

# Slippage tolerance percentage (0.01 = 1%)
SLIPPAGE_TOLERANCE=0.02

# ===== OPERATIONAL SETTINGS =====
# Enable dry run mode (true/false) - simulates trades without executing
DRY_RUN=true

# Polling interval in seconds (if not using WebSocket)
POLL_INTERVAL=60

# Database file path
DATABASE_PATH=./polymarket.db

# Log level (debug, info, warn, error)
LOG_LEVEL=info
